# Pulse backend — local environment (gitignored, never commit)

PORT=4000
NODE_ENV=development

# --- Supabase ---
SUPABASE_URL=https://your-supabase-project.supabase.co
# Service-role key — server-side only: auth.getUser() verification + admin
# tasks that bypass RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Database (Supabase Postgres via Prisma) ---
# Transaction pooler — used by the Prisma client (the app).
# Password percent-encoded as needed.
DATABASE_URL="postgresql://postgres.your-project:your_password@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session pooler / direct — used for migrations (prisma migrate / db push).
DIRECT_URL="postgresql://postgres.your-project:your_password@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# --- DeepSeek AI ---
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash

# --- QStash (background jobs) ---
QSTASH_URL=https://qstash-us-east-1.upstash.io
QSTASH_TOKEN=your_qstash_token
QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key
QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key

# --- Monad ---
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Authorized resolver wallet = PulseMarket deployer (same key as contracts/.env).
# NEVER expose to the browser.
RESOLVER_PRIVATE_KEY=0x_your_resolver_private_key

# --- Deployed contract addresses (Monad testnet, deployed 2026-08-20) ---
PULSE_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
PULSE_MARKET_ADDRESS=0x0000000000000000000000000000000000000000

# --- Sports provider ---
SPORTS_MODE=real
SPORTS_API_KEY=your_sports_api_key
# How often the QStash cron polls the sports provider (seconds)
POLL_INTERVAL_SECONDS=10

# --- Market engine (spec §12: create market when intensity > 0.80) ---
MARKET_INTENSITY_THRESHOLD=0.8

# --- Public base URL of this API (QStash callback URLs) ---
PUBLIC_BASE_URL=http://localhost:4000
